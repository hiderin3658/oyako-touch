# 認証（Auth.js v5 / NextAuth + Google）
# AUTH_SECRET は本番で必須（未設定だと起動時にエラー）。`npx auth secret` 等で生成する
AUTH_SECRET=
# GOOGLE_CLIENT_ID / SECRET は auth.ts で Provider へ明示的に渡している
# （v5 の自動推論 AUTH_GOOGLE_ID/SECRET は使わず、この env 名を維持する）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# AUTH_URL は trustHost:true のため通常は不要（リバースプロキシ等で必要なら設定）。
# Google Cloud Console の「承認済みリダイレクト URI」には次を登録する:
#   http://localhost:3000/api/auth/callback/google （本番はドメイン置換）

# 許可リスト（カンマ区切り・DB不使用）。空のままだと誰もログインできない（fail-closed）
ALLOWED_EMAILS=

# E2E（Playwright）専用のテスト認証フラグ。"true" のときだけテスト用 Credentials を有効化する。
# 本番では絶対に設定しないこと（実 OAuth を踏まずにログインできてしまうため）
E2E_TEST_AUTH=

# 音声生成（生成スクリプト専用・本番ランタイムには不要）
# ── ナレーション(TTS): Google Cloud Text-to-Speech ──
# ※API キーは不可。サービスアカウント JSON 鍵のパスを指定する（OAuth2/JWT）
# Google Cloud で Text-to-Speech API 有効化→サービスアカウント作成→JSON鍵をDL→そのパスを設定
GOOGLE_APPLICATION_CREDENTIALS=./gcp-tts-key.json
GOOGLE_TTS_VOICE=ja-JP-Neural2-B
GOOGLE_TTS_LANGUAGE_CODE=ja-JP
GOOGLE_TTS_SPEAKING_RATE=0.9
# ── 効果音(SFX): ElevenLabs（任意・効果音だけ生成する場合のみ）──
ELEVENLABS_API_KEY=

# ── 比較用: Gemini TTS（AI Studio・任意）──
# Cloud TTS と聴き比べる実験用。APIキーは AI Studio で発行（https://aistudio.google.com/apikey）
# 実行: npm run gen:audio:gemini （対象確認は npm run gen:audio:gemini:dry）
GEMINI_API_KEY=
# 以下は任意（未設定なら既定値）。
# モデル: gemini-2.5-flash-preview-tts / gemini-3.1-flash-tts-preview / gemini-2.5-pro-preview-tts
GEMINI_TTS_MODEL=gemini-2.5-pro-preview-tts
# 声は Leda/Kore/Aoede/Puck など30種から選べる
GEMINI_TTS_VOICE=Leda
# 口調をことばで指定（空文字にすると素読み）
GEMINI_TTS_STYLE=おさない子どもにやさしく、ゆっくり、あかるい声で
# 出力形式 mp3（既定・要 ffmpeg）/ wav。本番配信は mp3 推奨
GEMINI_TTS_FORMAT=mp3
